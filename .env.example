APP_SECRET=<long-random-string-used-to-sign-session-tokens>

DATABASE_URL=mysql://user:pass@host:3306/dbname

# Optional: override the seeded admin account (see db/seed.ts)
# ADMIN_EMAIL=admin@yourdomain.com
# ADMIN_PASSWORD=<choose-a-strong-password>

# Google Tag Manager container ID (e.g. GTM-XXXXXXX).
# When set, the GTM snippet loads sitewide and conversion events fire.
# GA4 and Google Ads tags are configured inside the GTM container.
VITE_GTM_ID=<your-value>

ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME-